{
  "name": "wizbiz-game",
  "version": "1.0.1",
  "description": "A magical wizard adventure game",
  "main": "scripts/main.js",
  "scripts": {
    "start": "electron .",
    "compile": "tsc || exit 0",
    "build-win": "npm run compile && electron-builder --win",
    "build-win-portable": "npm run compile && electron-builder --win portable",
    "build-portable": "npm run compile && node build-portable.js",
    "build-mac": "npm run compile && electron-builder --mac",
    "build-linux": "npm run compile && electron-builder --linux",
    "dist": "npm run compile && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "game",
    "phaser",
    "wizard"
  ],
  "author": "Alex",
  "license": "ISC",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "phaser": "^3.90.0"
  },
  "build": {
    "appId": "com.alex.wizbiz",
    "productName": "WizBiz",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "build/**/*",
      "!node_modules/**/*",
      "!dist/**/*",
      "!.git/**/*",
      "!.gitignore",
      "!src/**/*.ts",
      "!src/**/*.js.old"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null,
      "signAndEditExecutable": false,
      "signDlls": false,
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
