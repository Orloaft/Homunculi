{
  "name": "wizbiz-game",
  "version": "1.0.1",
  "description": "A magical wizard adventure game",
  "main": "scripts/main.js",
  "engines": {
    "node": ">=20 <26"
  },
  "scripts": {
    "prestart": "npm run compile",
    "start": "electron --no-sandbox --disable-gpu .",
    "typecheck": "tsc --noEmit",
    "compile": "tsc",
    "smoke:prod": "npm run compile && HOMUNCULI_SMOKE=1 electron --no-sandbox --disable-gpu .",
    "smoke:progression": "npm run compile && HOMUNCULI_PROGRESSION_SMOKE=1 electron --no-sandbox --disable-gpu .",
    "smoke:feel": "npm run compile && HOMUNCULI_FEEL_SMOKE=1 electron --no-sandbox --disable-gpu .",
    "smoke:live": "npm run compile && HOMUNCULI_STAGE_LIVE_SMOKE=1 electron --no-sandbox --disable-gpu .",
    "smoke:forest-live": "npm run compile && HOMUNCULI_FOREST_LIVE_SMOKE=1 electron --no-sandbox --disable-gpu .",
    "smoke:swamp-live": "npm run compile && HOMUNCULI_SWAMP_LIVE_SMOKE=1 electron --no-sandbox --disable-gpu .",
    "smoke:snow-live": "npm run compile && HOMUNCULI_STAGE_LIVE_SMOKE=1 HOMUNCULI_LIVE_SMOKE_STAGE=snow HOMUNCULI_LIVE_SMOKE_ELEMENT=fire HOMUNCULI_LIVE_SMOKE_ENEMY_DISTANCE=120 electron --no-sandbox --disable-gpu .",
    "smoke:ocean-live": "npm run compile && HOMUNCULI_OCEAN_LIVE_SMOKE=1 electron --no-sandbox --disable-gpu .",
    "smoke:lava-live": "npm run compile && HOMUNCULI_STAGE_LIVE_SMOKE=1 HOMUNCULI_LIVE_SMOKE_STAGE=lava HOMUNCULI_LIVE_SMOKE_ELEMENT=fire HOMUNCULI_LIVE_SMOKE_ENEMY_DISTANCE=135 electron --no-sandbox --disable-gpu .",
    "smoke:swamp-boss": "npm run compile && HOMUNCULI_SWAMP_BOSS_SMOKE=1 electron --no-sandbox --disable-gpu .",
    "smoke:snow-boss": "npm run compile && HOMUNCULI_SNOW_BOSS_SMOKE=1 electron --no-sandbox --disable-gpu .",
    "smoke:ocean-boss": "npm run compile && HOMUNCULI_OCEAN_BOSS_SMOKE=1 electron --no-sandbox --disable-gpu .",
    "smoke:lava-boss": "npm run compile && HOMUNCULI_LAVA_BOSS_SMOKE=1 electron --no-sandbox --disable-gpu .",
    "verify:smoke": "npm run smoke:prod && npm run smoke:feel && npm run smoke:progression",
    "verify:release": "npm run typecheck && npm run compile && npm run smoke:prod && npm run smoke:feel && npm run smoke:progression && npm run smoke:forest-live && npm run smoke:swamp-live && npm run smoke:snow-live && npm run smoke:ocean-live && npm run smoke:lava-live && npm run smoke:swamp-boss && npm run smoke:snow-boss && npm run smoke:ocean-boss && npm run smoke:lava-boss",
    "build-win": "npm run compile && electron-builder --win",
    "build-win-portable": "npm run compile && electron-builder --win portable",
    "build-portable": "npm run build-win-portable",
    "build-mac": "npm run compile && electron-builder --mac",
    "build-linux": "npm run compile && electron-builder --linux",
    "dist": "npm run compile && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "game",
    "phaser",
    "wizard"
  ],
  "author": "Alex",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.19.41",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "phaser": "^3.90.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.alex.wizbiz",
    "productName": "WizBiz",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "package.json",
      "icon.png",
      "hitboxes.json",
      "loop-assets.json",
      "used-assets.json",
      "assets/**/*",
      "sfx/**/*",
      "gamecartridge/**/*",
      "scripts/**/*",
      "build/**/*",
      "src/**/*.js",
      "!node_modules/**/*",
      "!dist/**/*",
      "!.git/**/*",
      "!.gitignore",
      "!docs/**/*",
      "!sprite-editor/**/*",
      "!scythewraith/**/*",
      "!src/tests/**/*",
      "!src/**/*.ts",
      "!assets/**/*.ase",
      "!assets/**/*.aseprite",
      "!**/*.map",
      "!**/*.old",
      "!**/*.bak",
      "!**/*.backup"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null,
      "signAndEditExecutable": false,
      "signDlls": false,
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
